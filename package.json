{
  "name": "dislop",
  "version": "0.8.1",
  "description": "Cutting AI slop is real productivity. Linter for AI Slop in docs, web UI, and slides — Skill, Plugin, CLI & MCP.",
  "license": "Apache-2.0",
  "homepage": "https://dislop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dislop-ai/dislop.git"
  },
  "bugs": {
    "url": "https://github.com/dislop-ai/dislop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/core.mjs",
    "./core": "./src/core.mjs",
    "./pattern-engine": "./src/pattern-engine.mjs",
    "./pocket-model": "./src/pocket-model.mjs",
    "./local-model": "./src/local-model.mjs",
    "./binary-node": "./src/binary-node.mjs"
  },
  "bin": {
    "dislop": "bin/dislop.mjs",
    "dislop-mcp": "bin/dislop-mcp.mjs"
  },
  "scripts": {
    "test": "node bin/dislop.mjs pack-test && node tests/test_site.mjs",
    "test:patterns": "node scripts/pattern_lab.mjs verify && node scripts/pattern_lab.mjs assert",
    "test:models": "PYTHONPATH=src python3 scripts/train_pocket_models.py --eval-only",
    "bench": "node scripts/run_benchmark.mjs",
    "bench:assert": "node scripts/run_benchmark.mjs --assert",
    "bench:skill": "node scripts/run_skill_benchmark.mjs --assert",
    "bench:patterns": "node scripts/pattern_lab.mjs ablation",
    "bench:visual": "node scripts/run_visual_benchmark.mjs",
    "bench:visual:vlm": "node scripts/run_visual_vlm_bench.mjs",
    "build:site": "node scripts/build_site.mjs",
    "sync:manifests": "node scripts/sync_manifests.mjs",
    "check:manifests": "node scripts/sync_manifests.mjs --check",
    "release:check": "node scripts/release.mjs --check",
    "release:status": "node scripts/release.mjs --status",
    "release": "node scripts/release.mjs",
    "dogfood": "node bin/dislop.mjs check . --fail-on warning && node bin/dislop.mjs check site/ --fail-on info && node scripts/media/audit_visual_assets.mjs --assert",
    "media:render": "python3 scripts/media/render_gifs.py",
    "media:verify": "python3 scripts/media/verify_demos.py",
    "media:bench": "python3 scripts/media/bench_encoders.py",
    "media:audit": "node scripts/media/audit_visual_assets.mjs --assert"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    ".mcp.json",
    ".pre-commit-hooks.yaml",
    "action.yml",
    "gemini-extension.json",
    "mcp.json",
    "plugin.json",
    "server.json",
    "bin/",
    "src/core.mjs",
    "src/review-client.mjs",
    "src/pattern-engine.mjs",
    "src/pocket-model.mjs",
    "src/local-model.mjs",
    "src/binary-node.mjs",
    "models/",
    "packs/",
    "patterns/taxonomy.json",
    "patterns/ai-tic-rubric.json",
    "patterns/dimensions/",
    "patterns/banks/",
    "skills/",
    "assets/logo.svg",
    "README.md",
    "README.zh-CN.md",
    "PRODUCT.md",
    "LICENSE"
  ],
  "keywords": [
    "anti-slop",
    "de-slop",
    "ai-slop",
    "humanizer",
    "linter",
    "proofreading",
    "agent-skill",
    "claude-code",
    "codex",
    "cursor",
    "llms-txt",
    "mcp",
    "model-context-protocol",
    "markdown",
    "docx",
    "pptx",
    "editorial",
    "typography",
    "quality-gate"
  ],
  "mcpName": "io.github.dislop-ai/dislop",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
