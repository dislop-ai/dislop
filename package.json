{
  "name": "dislop",
  "version": "1.0.0",
  "description": "Pluggable Editorial & Artifact Linter (Node.js Micro-Kernel) — Dual-track Defect & Suggestion engine with local-first 3-Tier LLM routing, Fact Gate, interactive hunk review, and MCP.",
  "license": "Apache-2.0",
  "homepage": "https://dislop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dislop-ai/dislop.git"
  },
  "bugs": {
    "url": "https://github.com/dislop-ai/dislop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/sdk/index.mjs",
    "./sdk": "./src/sdk/index.mjs"
  },
  "bin": {
    "dislop": "./bin/dislop.mjs",
    "dislop-mcp": "./bin/dislop-mcp.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dogfood": "node ./bin/dislop.mjs check README.md --no-llm"
  },
  "files": [
    "bin/",
    "src/",
    "packs/",
    "skills/",
    "assets/logo.svg",
    "README.md",
    "PRODUCT.md",
    "LICENSE"
  ],
  "keywords": [
    "anti-slop",
    "de-slop",
    "ai-slop",
    "linter",
    "editorial",
    "proofreading",
    "markdown",
    "docx",
    "pptx",
    "mcp",
    "agent-skill"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
