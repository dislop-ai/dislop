{
  "name": "dislop",
  "version": "1.1.2",
  "description": "Pluggable Editorial & Artifact Linter (Node.js Micro-Kernel) — Dual-track Defect & Suggestion engine with local-first 3-Tier LLM routing, Fact Gate, interactive hunk review, and MCP.",
  "license": "Apache-2.0",
  "homepage": "https://dislop.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dislop-ai/dislop.git"
  },
  "bugs": {
    "url": "https://github.com/dislop-ai/dislop/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "exports": {
    ".": "./src/sdk/index.mjs",
    "./sdk": "./src/sdk/index.mjs"
  },
  "bin": {
    "dislop": "./bin/dislop.mjs",
    "dislop-mcp": "./bin/dislop-mcp.mjs"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:security": "node ./scripts/verify-packs-security.mjs",
    "bench": "node ./scripts/run-benchmark.mjs",
    "bench:assert": "node ./scripts/run-benchmark.mjs --assert",
    "dogfood": "node ./bin/dislop.mjs check README.md README.zh-CN.md CONTRIBUTING.md PRODUCT.md AGENTS.md SECURITY.md CHANGELOG.md llms-install.md docs/architecture.md docs/brand-and-voice-guide.md docs/brand-and-voice-guide.zh-CN.md docs/MIGRATION-TODO.md benchmarks/README.md benchmarks/REPORT.md skills/ assets/*.svg .github/PULL_REQUEST_TEMPLATE.md --no-llm"
  },
  "files": [
    ".agents/plugins/marketplace.json",
    ".claude-plugin/",
    ".codex-plugin/",
    ".cursor-plugin/",
    ".mcp.json",
    ".pre-commit-hooks.yaml",
    "action.yml",
    "gemini-extension.json",
    "mcp.json",
    "plugin.json",
    "server.json",
    "llms-install.md",
    "bin/",
    "src/",
    "packs/",
    "skills/",
    "assets/logo.svg",
    "README.md",
    "README.zh-CN.md",
    "PRODUCT.md",
    "LICENSE"
  ],
  "mcpName": "io.github.dislop-ai/dislop",
  "keywords": [
    "anti-slop",
    "de-slop",
    "ai-slop",
    "linter",
    "editorial",
    "proofreading",
    "markdown",
    "docx",
    "pptx",
    "mcp",
    "agent-skill"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
