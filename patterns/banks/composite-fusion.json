{
  "schema": "dislop.pattern-bank/1",
  "id": "composite-fusion",
  "version": "1.0.0",
  "description": {
    "en": "Multi-dimension weak-signal co-occurrence fusion rules to detect stealth AI prose that evades single-dimension thresholds while staying low in concrete facts.",
    "zh": "跨维度弱信号复合共现规则：用于在无单条硬规则触发时，检出低具体度、多维度叠加的隐蔽 AI 味段落。"
  },
  "ruleId": "composite-multi-signal",
  "dimension": "discourse",
  "detectionAngle": "composite-cooccurrence",
  "severity": "info",
  "minDistinctDimensions": 3,
  "maxFactSignals": 1,
  "weakFramingPatterns": [
    "\\bplays? a (?:key|vital|critical|central|important|crucial) role\\b",
    "\\bdelivers? (?:real|meaningful|lasting|tangible|significant) value\\b",
    "\\bmodern workflows?\\b",
    "\\bmoving forward\\b",
    "\\bremains? (?:essential|critical|vital|key)\\b",
    "\\bunlock(?:s|ing)? new\\b",
    "具有重要意义",
    "带来[^，。！？\\n]{0,6}(?:价值|体验|变革|提升)",
    "助力[^，。！？\\n]{0,8}(?:发展|增长|升级|转型)",
    "实现[^，。！？\\n]{0,6}(?:跨越|跃升|升级|突破)",
    "值得(?:关注|深思|期待)",
    "成为[^，。！？\\n]{0,8}(?:关键|核心|趋势)",
    "标志着[^，。！？\\n]{2,14}(?:新阶段|里程碑)",
    "奠定[^，。！？\\n]{0,6}坚实基础",
    "彰显(?:了)?[^，。！？\\n]{1,10}",
    "有利有弊",
    "仁者见仁",
    "说白了",
    "归根结底",
    "\\btestament to\\b",
    "\\bmarks a pivotal\\b",
    "\\bworth noting\\b",
    "\\bultimately depends\\b",
    ",\\s+(?:highlighting|underscoring|showcasing|fostering)\\s+(?:its|the|how)\\b"
  ],
  "concreteFactPatterns": [
    "\\b\\d+(?:\\.\\d+)?\\s*(?:ms|s|sec|seconds?|min|minutes?|hours?|days?|weeks?|KB|MB|GB|TB|QPS|TPS|%|px|pt|Hz|UTC)\\b",
    "\\d+(?:\\.\\d+)?\\s*(?:毫秒|秒|分钟|小时|天|周|个月|年|次|条|台|个|家|倍|万|亿|%)",
    "`[^`\\n]{2,40}`",
    "\\b[A-Za-z0-9_-]+\\.(?:mjs|js|ts|py|json|yaml|yml|md|html|css|sql|sh)\\b",
    "\\b(?:19|20)\\d{2}-\\d{2}-\\d{2}\\b|\\b\\d{1,2}:\\d{2}\\b"
  ]
}
