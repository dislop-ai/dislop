{
  "schema": "dislop.pattern-bank/1",
  "id": "visual-deck",
  "version": "1.0.0",
  "description": {
    "en": "Declarative structural thresholds and regexes for Web UI glassmorphism overuse, thick accent-stripe card stacks, and PowerPoint cross-slide layout monotony.",
    "zh": "网页毛玻璃面板滥用、侧边粗彩条卡片堆叠与 PPT 跨页版式单调的声明式检测配置。"
  },
  "glassmorphismOveruse": {
    "ruleId": "ui-glassmorphism-overuse",
    "dimension": "visual-and-deck",
    "detectionAngle": "visual-markup-ooxml",
    "severity": "warning",
    "minOccurrences": 3,
    "pattern": "\\bbackdrop-blur(?:-[a-z0-9]+)?\\b|backdrop-filter\\s*:\\s*blur\\("
  },
  "accentStripeCard": {
    "ruleId": "ui-accent-stripe-card",
    "dimension": "visual-and-deck",
    "detectionAngle": "visual-markup-ooxml",
    "severity": "warning",
    "minOccurrences": 3,
    "pattern": "\\bborder-l-(?:4|8)\\b|border-left\\s*:\\s*(?:[4-9]|\\d{2,})px\\s+solid\\b",
    "exemptLookbehindChars": 48,
    "exemptPattern": "\\bblockquote\\b"
  },
  "pptxLayoutMonotony": {
    "ruleId": "pptx-layout-monotony",
    "dimension": "visual-and-deck",
    "detectionAngle": "visual-markup-ooxml",
    "severity": "info",
    "minContentSlides": 5,
    "minConsecutivePlainBulletSlides": 4,
    "minSlideLatinWords": 12,
    "minSlideCjkChars": 25
  },
  "gen2TastefulSlop": {
    "ruleId": "ui-gen2-tasteful-slop",
    "dimension": "visual-and-deck",
    "detectionAngle": "visual-markup-ooxml",
    "severity": "info",
    "minSignals": 2
  }
}
