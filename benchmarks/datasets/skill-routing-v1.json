    {
      "id": "rt-pos-11-en-clean-check",
      "lang": "en",
      "host": "coding-agent",
      "intent": "revise",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Run a pre-send slop check on docs/changelog.md; if it already reads clean and preserves metrics, leave it untouched."
    },
    {
      "id": "rt-pos-12-en-gptzero-boundary",
      "lang": "en",
      "host": "office-agent",
      "intent": "revise",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Help me rewrite this product brief so it passes GPTZero without sounding robotic."
    },
    {
