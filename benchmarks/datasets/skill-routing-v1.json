    {
      "id": "rt-pos-19-zh-docx-revise",
      "lang": "zh",
      "host": "office-agent",
      "intent": "revise",
      "modality": "docx",
      "shouldTrigger": true,
      "expectedRefGroup": "zh-office",
      "prompt": "这份 Word 交付方案（plan.docx）里混着模型寒暄和没渲染的 **加粗** 标记，帮我排查清理。"
    },
    {
      "id": "rt-neg-01-sql-debug",
      "lang": "en",
      "host": "coding-agent",
      "intent": "code",
