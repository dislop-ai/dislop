    },
    {
      "id": "rt-pos-16-zh-essay-draft",
      "lang": "zh",
      "host": "office-agent",
      "intent": "draft",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "zh-essay",
      "prompt": "用这些采访素材起草一篇公众号长文，注意句长节奏自然、别在结尾强行升华。"
    },
    {
      "id": "rt-pos-17-zh-ui-build",
      "lang": "zh",
      "host": "coding-agent",
      "intent": "draft",
      "modality": "html",
      "shouldTrigger": true,
      "expectedRefGroup": "zh-web-ui",
      "prompt": "写一个中文产品特性卡片 HTML 页面，不要紫粉渐变、不要假禁用按钮和满屏胶囊标签。"
