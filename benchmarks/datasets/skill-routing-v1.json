{
  "schema": "dislop.skill-bench-routing/1",
  "version": "1.1.0",
  "license": "CC0-1.0",
  "description": "32-task bilingual Skill trigger & reference-card routing benchmark (21 true triggers across Coding/Office, EN/ZH, cross-language prompts, Drafting/Review, Docs/UI/DOCX/PPTX, implicit prompts, CLI copy, and ethical anti-detector boundary + 11 non-slop negative controls).",
  "cases": [
    {
      "id": "rt-pos-01-en-rfc-draft",
      "lang": "en",
      "host": "coding-agent",
      "intent": "draft",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Draft a concise engineering RFC for moving payment retries to an exponential backoff queue (max 8s, 3 attempts). Avoid AI filler and keep the metrics concrete."
    },
    {
      "id": "rt-pos-02-en-pr-review",
      "lang": "en",
      "host": "coding-agent",
      "intent": "revise",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Polish this pull request description and postmortem summary before I submit it so it doesn't sound like ChatGPT wrote it."
    },
    {
      "id": "rt-pos-03-en-implicit-release",
      "lang": "en",
      "host": "coding-agent",
      "intent": "draft",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Write the v2.3 release notes and CHANGELOG section for our storage engine from these benchmark tickets."
    },
    {
      "id": "rt-pos-04-en-cli-copy",
      "lang": "en",
      "host": "coding-agent",
      "intent": "revise",
      "modality": "text",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Review our CLI `--help` text and error messages for stiff AI phrasing or unclear recovery instructions."
    },
    {
      "id": "rt-pos-05-en-essay-draft",
      "lang": "en",
      "host": "office-agent",
      "intent": "draft",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-essay",
      "prompt": "Write a 3-paragraph personal newsletter column from my field notes about visiting an old municipal waterworks plant at dawn."
    },
    {
      "id": "rt-pos-06-en-essay-revise",
      "lang": "en",
      "host": "office-agent",
      "intent": "revise",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-essay",
      "prompt": "Check this op-ed draft for AI cadence, em-dash overuse, and moralizing closing sentences, and clean it up."
    },
    {
      "id": "rt-pos-07-en-ui-build",
      "lang": "en",
      "host": "coding-agent",
      "intent": "draft",
      "modality": "html",
      "shouldTrigger": true,
      "expectedRefGroup": "en-web-ui",
      "prompt": "Build a clean HTML/Tailwind status dashboard card for our queue latency metrics without generic AI neon gradients or pill clutter."
    },
    {
      "id": "rt-pos-08-en-pptx-audit",
      "lang": "en",
      "host": "office-agent",
      "intent": "revise",
      "modality": "pptx",
      "shouldTrigger": true,
      "expectedRefGroup": "en-office",
      "prompt": "Review this Q3 executive board slide deck (.pptx) for generic titles, wall-of-text slides, and repetitive layouts."
    },
    {
      "id": "rt-pos-09-en-docx-clean",
      "lang": "en",
      "host": "office-agent",
      "intent": "revise",
      "modality": "docx",
      "shouldTrigger": true,
      "expectedRefGroup": "en-office",
      "prompt": "We pasted AI draft notes into customer-proposal.docx and some **bold** markdown and filler stayed behind. Check and clean the Word doc."
