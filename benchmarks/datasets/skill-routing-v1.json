    {
      "id": "rt-pos-10-en-sla-regulated",
      "lang": "en",
      "host": "office-agent",
      "intent": "revise",
      "modality": "markdown",
      "shouldTrigger": true,
      "expectedRefGroup": "en-work-docs",
      "prompt": "Edit this customer security & SLA announcement before legal sign-off. Keep 'up to 15 minutes' and '99.95%' exact and strip hype claims."
