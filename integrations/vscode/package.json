{
  "name": "dislop",
  "displayName": "dislop",
  "description": "Cutting AI slop is real productivity. Linter for AI Slop in docs and web UI (7 packs, 53 rules, offline).",
  "version": "0.8.1",
  "publisher": "dislop-ai",
  "license": "Apache-2.0",
  "homepage": "https://dislop.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/dislop-ai/dislop.git"
  },
  "bugs": {
    "url": "https://github.com/dislop-ai/dislop/issues"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "anti-slop",
    "de-slop",
    "ai-slop",
    "humanizer",
    "markdown",
    "proofreading",
    "copywriting",
    "linter",
    "mcp"
  ],
  "engines": {
    "vscode": "^1.96.0"
  },
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:mdx",
    "onLanguage:plaintext",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onCommand:dislop.checkCurrentFile"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "vscode:prepublish": "node scripts/build.mjs",
    "build": "node scripts/build.mjs",
    "test": "node test_extension.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "dislop.checkCurrentFile",
        "title": "dislop: Check Current File"
      },
      {
        "command": "dislop.insertIgnoreLine",
        "title": "dislop: Ignore Rule on Next Line"
      }
    ],
    "configuration": {
      "title": "dislop",
      "properties": {
        "dislop.checkOn": {
          "type": "string",
          "enum": [
            "save",
            "type"
          ],
          "default": "save",
          "description": "When to refresh dislop diagnostics: on file save or after typing pauses."
        },
        "dislop.debounceMs": {
          "type": "number",
          "default": 300,
          "minimum": 100,
          "maximum": 3000,
          "description": "Typing pause in milliseconds before re-checking when dislop.checkOn is set to type."
        },
        "dislop.pack": {
          "type": "string",
          "enum": [
            "auto",
            "core",
            "business-brief",
            "engineering-spec",
            "regulated-comms",
            "literary-essay",
            "deck-and-ui",
            "executive-deck"
          ],
          "default": "auto",
          "description": "Rule pack used to check open files."
        },
        "dislop.minSeverity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ],
          "default": "info",
          "description": "Minimum severity shown in Problems and editor underlines."
        }
      }
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "dislop.mcp",
        "label": "dislop (Offline Anti-Slop MCP)"
      }
    ],
    "languageModelTools": [
      {
        "name": "dislop_check_document",
        "displayName": "Check Document for AI Slop",
        "modelDescription": "Run dislop deterministic anti-slop audit on text offline using the 7 built-in packs (53 rules).",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "dislopCheck",
        "inputSchema": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "description": "Document text to audit."
            },
            "filename": {
              "type": "string",
              "description": "Filename or extension hint such as draft.md or page.tsx."
            },
            "pack": {
              "type": "string",
              "description": "Optional rule pack ID (defaults to auto)."
            }
          },
          "required": [
            "text"
          ]
        }
      }
    ]
  }
}
